# 복사해서 .env로 쓴다. .env는 gitignore 대상이다. 비밀값은 여기에만 둔다.

# --- 체인 RPC ---
# 로컬 Anvil (기본값 http://127.0.0.1:8545, ws://127.0.0.1:8545)
ANVIL_RPC_URL=
ANVIL_WS_URL=
SEPOLIA_RPC_URL=
SEPOLIA_WS_URL=
CUSTOM_CHAIN_RPC_URL=
CUSTOM_CHAIN_WS_URL=
CUSTOM_CHAIN_ID=

# --- 검증 ---
ETHERSCAN_API_KEY=

# --- 배포 (스크립트 작성용. --broadcast는 사용자 지시가 있을 때만) ---
# 배포 키는 forge의 --account(키스토어)나 --ledger로 넘긴다. 로컬은 Anvil 기본 키만 쓴다.

# --- 오프체인 ---
# 감시탑이 쓸 체인: anvil | sepolia | custom (config/addresses.<CHAIN>.yaml)
CHAIN=anvil
DATABASE_URL=postgres://stablecoin:stablecoin@localhost:5432/stablecoin
REDIS_URL=redis://localhost:6379
# STORE=memory 이면 DB 없이 메모리 저장소로 돈다 (재시작하면 상태가 사라짐, 로컬 전용)
STORE=
LOG_LEVEL=info

# 봇 서명. Sepolia는 암호화 키스토어, 운영은 KMS (docs/decisions.md 3절)
BOT_KEYSTORE_PATH=
BOT_KEYSTORE_PASSWORD=
BOT_KMS_KEY_ID=

# 자동 동결 모드: shadow | auto | off
RESPONDER_MODE=shadow
# 커서가 없을 때 시작 블록: 비우면 배포 블록, latest면 현재 블록 (메모리 저장소 시연용), 또는 블록 번호
WATCH_FROM=
# 제출 경로는 config/rules.yaml의 responder.submit_route (핫리로드). 프라이빗 제출 RPC:
PRIVATE_RPC_URL=

# --- 원클릭 승인 (Notifier) ---
# 32바이트 이상 임의 문자열. 링크 서명용
APPROVAL_SIGNING_KEY=
# 운영자 "이름:sha256(운영자 토큰) hex"를 쉼표로. 토큰 원문은 저장하지 않는다
APPROVAL_OPERATORS=
APPROVAL_PORT=8787

# --- 알림 채널 (config/rules.yaml notifier.channels에서 켠다) ---
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- 시연 (packages/ops-cli/src/demo-main.ts의 init이 채운다. 테스트넷 전용 키) ---
DEMO_MNEMONIC=
