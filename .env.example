# 복사해서 .env로 쓴다. .env는 gitignore 대상이다. 비밀값은 여기에만 둔다.

# --- 체인 RPC ---
SEPOLIA_RPC_URL=
SEPOLIA_WS_URL=
CUSTOM_CHAIN_RPC_URL=
CUSTOM_CHAIN_WS_URL=
CUSTOM_CHAIN_ID=

# --- 검증 ---
ETHERSCAN_API_KEY=

# --- 배포 (스크립트 작성용. --broadcast는 사용자 지시가 있을 때만) ---
# 테스트넷 배포자 키. 로컬은 Anvil 기본 키만 쓴다.
DEPLOYER_PRIVATE_KEY=

# --- 오프체인 ---
DATABASE_URL=postgres://stablecoin:stablecoin@localhost:5432/stablecoin
REDIS_URL=redis://localhost:6379

# 봇 서명. Sepolia는 암호화 키스토어, 운영은 KMS (docs/decisions.md 3절)
BOT_KEYSTORE_PATH=
BOT_KEYSTORE_PASSWORD=
BOT_KMS_KEY_ID=

# 자동 동결 모드: shadow | auto | off
RESPONDER_MODE=shadow
# 제출 경로: private_first | public_only | both
RESPONDER_SUBMIT_ROUTE=both
